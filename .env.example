# Public client configuration only. See docs/email-auth-setup.md.
# Never put service-role keys or SMTP passwords in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Enable only after custom SMTP and real email delivery have been verified.
VITE_AUTH_EMAIL_DELIVERY_READY=false
VITE_IDENTITY_VERIFICATION_READY=false
